@page
@model AltaMotoModel
@{
    ViewData["Title"] = "Nueva Orden de Reparación";
}

<h2 class="text-2xl font-bold mb-6">Nueva Orden de Reparación</h2>

<form method="post" class="bg-white dark:bg-gray-900 shadow-md rounded-xl p-8 max-w-2xl mx-auto border border-gray-200 dark:border-gray-700 space-y-6">

    <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

    <h3 class="text-lg font-semibold border-b pb-2 mb-4">Identificación del Activo</h3>

    <div>
        <label class="block text-sm font-medium mb-1">Patente</label>
        <input asp-for="Moto.Patente" class="input input-bordered w-full" placeholder="Ej: AAA 123" />
        <span asp-validation-for="Moto.Patente" class="text-red-600 text-sm"></span>
    </div>

    <div>
        <label class="block text-sm font-medium mb-1">ID Usuario (Dueño/Cliente)</label>
        <input asp-for="Moto.IdUsuario" type="number" class="input input-bordered w-full" placeholder="Ej: 4 (Sofía Fernández)" />
        <span asp-validation-for="Moto.IdUsuario" class="text-red-600 text-sm"></span>
    </div>

    <h3 class="text-lg font-semibold border-b pb-2 mb-4 mt-8">Detalles de la Reparación Inicial</h3>

    <div>
        <label asp-for="DniMecanicoPrincipal" class="block text-sm font-medium mb-1"></label>
        <input asp-for="DniMecanicoPrincipal" class="input input-bordered w-full" placeholder="DNI del mecánico responsable (Ej: 40400401)" />
        <span asp-validation-for="DniMecanicoPrincipal" class="text-red-600 text-sm"></span>
    </div>

    <div>
        <label asp-for="DescripcionOrden" class="block text-sm font-medium mb-1"></label>
        <textarea asp-for="DescripcionOrden" class="textarea textarea-bordered w-full" placeholder="Breve descripción del problema o motivo de ingreso."></textarea>
        <span asp-validation-for="DescripcionOrden" class="text-red-600 text-sm"></span>
    </div>

    <div>
        <label asp-for="ServicioDesc" class="block text-sm font-medium mb-1"></label>
        <input asp-for="ServicioDesc" class="input input-bordered w-full" placeholder="Ej: Ingreso y Diagnóstico" />
        <span asp-validation-for="ServicioDesc" class="text-red-600 text-sm"></span>
    </div>

    <div>
        <label asp-for="CostoServicio" class="block text-sm font-medium mb-1"></label>
        <input asp-for="CostoServicio" type="number" step="0.01" class="input input-bordered w-full" placeholder="0.00" />
        <span asp-validation-for="CostoServicio" class="text-red-600 text-sm"></span>
    </div>

    <div class="flex justify-between items-center mt-6">
        <a href="/MotosEnTaller" class="btn btn-ghost">Cancelar</a>
        <button type="submit" class="btn bg-blue-500 text-white hover:bg-blue-600">
            <i data-feather="save" class="w-4 h-4 mr-2"></i> Guardar Orden
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>feather.replace()</script>
}