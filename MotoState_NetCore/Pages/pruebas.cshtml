@page
@model MotoState__.NetCore_Razor.Pages.MotosEnTallerModel
@{
    ViewData["Title"] = "Pruebas";
}

<div class="relative flex flex-col items-center justify-center min-h-screen text-center px-4 overflow-hidden">
    <!-- Fondo con imagen -->
    <div class="absolute inset-0 bg-[url('/images/background/taller-bg.jpg')] bg-cover bg-center"></div>
    <!-- Capa oscura para contraste -->
    <div class="absolute inset-0 bg-black bg-opacity-60"></div>

    <h1 class="text-5xl font-bold mb-6 text-white z-10">¿Quién eres?</h1>
    <p class="text-lg text-gray-200 mb-10 z-10">Consulta el estado de tu moto en segundos</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 z-10">
        <a href="/Mecanico" 
           class="px-10 py-6 text-2xl text-white rounded-2xl shadow-2xl 
                  bg-white/10 backdrop-blur-md border border-white/30 
                  hover:shadow-2x1 hover:-translate-y-1 hover:bg-white/15 transition transform">
            🔧 Mecánico
        </a>

        <a href="/Cliente" 
           class="px-10 py-6 text-2xl text-white rounded-2xl shadow-2xl 
                  bg-white/10 backdrop-blur-md border border-white/30 
                  hover:shadow-xl hover:-translate-y-1 hover:bg-white/15 transition transform">
            🚲 Cliente
        </a>
    </div>
</div>


<h1 class="text-4xl font-bold mb-4">Dies;o 4:</h1>
<div class="relative flex flex-col items-center justify-center min-h-screen text-center text-white">
    <!-- Fondo estilo CoolFix -->
    <div class="absolute inset-0 bg-[url('/images/moto-workshop.jpg')] bg-cover bg-center"></div>
    <div class="absolute inset-0 bg-black bg-opacity-60"></div>

    <h1 class="text-5xl font-extrabold mb-6 z-10">Reparación Rápida de Motos</h1>
    <p class="text-lg mb-8 z-10">Consulta el estado con tu patente o ingresa como mecánico</p>

    <div class="flex space-x-6 z-10">
        <a href="/Mecanico" class="px-6 py-3 bg-indigo-600 rounded-full shadow-lg hover:bg-indigo-700 hover:scale-105 transition">
            🔧 Soy Mecánico
        </a>
        <a href="/Cliente" class="px-6 py-3 bg-green-600 rounded-full shadow-lg hover:bg-green-700 hover:scale-105 transition">
            🚲 Ver Estado
        </a>
    </div>
</div>

<h2 class="text-2xl font-bold mb-6">Pizarra de Motos en el Taller</h2>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

    <!-- Tarjeta con Skeleton (placeholder inicial) -->
    <div id="card-container" class="card-container">
        <div class="card-body border rounded-xl shadow p-4 flex flex-col bg-white dark:bg-gray-900 border-gray-200 dark:border-gray-700">
            <div class="flex flex-col gap-4 w-full">
                <div class="skeleton h-32 w-full rounded-xl"></div>
                <div class="skeleton h-4 w-28"></div>
                <div class="skeleton h-4 w-full"></div>
                <div class="skeleton h-4 w-full"></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Simular carga de datos (0.5 segundos)
        setTimeout(() => {
            const container = document.getElementById("card-container");
            container.innerHTML = `
                <div class="card-body border rounded-xl shadow p-4 flex flex-col bg-white dark:bg-gray-900 border-gray-200 dark:border-gray-700 transition-transform duration-500 group/card">
                    <div data-translate-z="50">
                <img src="https://imgs.search.brave.com/_l1IOvATzB8D9b-19zOFCtVtPaRxpvRvMYESFVXIM3g/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly93d3cu/YmlrZWJvdW5kLmNv/bS93cC1jb250ZW50/L3VwbG9hZHMvMjAx/OC8wNi9CTVctSzEw/MC0yLTMwMHgyMDAu/anBn"
                            class="h-40 w-full object-contain rounded-xl group-hover/card:shadow-xl transition-shadow mb-4" alt="Yamaha MT07" />
                    </div>
                    <div data-translate-z="20" class="flex flex-col">
                        <h5 class="font-semibold text-lg mb-2">Yamaha MT07</h5>
                        <p class="text-sm mb-1">Fecha de ingreso: 02/04/2024</p>
                        <p class="text-sm mb-2">Problema con el encendido</p>
                    </div>
                    <div data-translate-z="10" class="flex items-center gap-2 mt-auto">
                        <span class="w-3 h-3 rounded-full bg-gray-400"></span>
                        <span class="text-sm font-medium">Esperando repuesto</span>
                    </div>
                </div>
            `;
        }, 800);
    </script>
}
